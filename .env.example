APP_ENV=development
LLM_PROVIDER=chatgpt_oauth
TEST_MODE=false
CHATGPT_MODEL=gpt-5.6-sol
OPENAI_OAUTH_PROXY_URL=http://127.0.0.1:10531/v1

# Optional cloud authentication. Keep secrets out of version control.
# CHATGPT_TOKEN_JSON=
# OPENAI_API_KEY=

# Optional: Tavily API for higher-quality web search (falls back to DuckDuckGo)
# TAVILY_API_KEY=
# DISABLE_WEB_SEARCH=false
